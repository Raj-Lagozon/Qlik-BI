# Qlik Cloud tenant used to import the local .qvf and read it back via the
# REST + Engine APIs. Find the tenant URL in Qlik Cloud under
# Management Console > (your tenant hostname).
QLIK_TENANT_URL=https://your-tenant.your-region.qlikcloud.com

# Qlik Cloud API key (Management Console > Integrations > API keys).
QLIK_API_KEY=

# Optional but usually required: a Qlik Cloud space id to import the .qvf
# into. API keys generally can't import apps into the personal space (403
# Forbidden), so pick a shared/managed space your API key's owner can create
# apps in. Find ids via the hub URL when a space is open (.../spaces/<id>)
# or GET /api/v1/spaces.
QLIK_SPACE_ID=

# Azure OpenAI (used by llm_convert to turn Qlik script/metadata into
# Power Query M, DAX, TMDL and PBIR JSON). Accessed via Azure's OpenAI-
# compatible v1 Responses API (endpoint + "/openai/v1/"), no api-version needed.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
